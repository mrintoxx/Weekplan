{
  "name": "weekplan",
  "version": "0.1.0",
  "description": "Daily Block Planner - Planning par blocs pour structurer vos journées",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\""
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/ui": "^4.1.4",
    "dayjs": "^1.11.20",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "idb": "^8.0.3",
    "immer": "^11.1.4",
    "jsdom": "^29.0.2",
    "lucide-react": "^1.8.0",
    "msw": "^2.13.4",
    "prettier": "^3.8.3",
    "react-router": "^7.14.1",
    "react-router-dom": "^7.14.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.2",
    "vite": "^6.4.2",
    "vitest": "^4.1.4",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "dependencies": {
    "react": "^19.0.0-rc.1",
    "react-dom": "^19.0.0-rc.1"
  }
